<%# app/views/users/new.html.erb %>
<div class="max-w-md mx-auto mt-10 p-6 bg-white rounded-lg shadow-lg">
  <div class="flex justify-between items-center mb-6">
    <h2 class="text-2xl font-bold text-gray-800">Create Account</h2>
    <%= link_to 'Back to Users', users_path, class: "text-blue-600 hover:text-blue-800 transition-colors duration-200" %>
  </div>

  <% if flash[:notice].present? %>
    <div class="mb-4 p-4 rounded-md bg-green-50 border border-green-200">
      <p class="text-green-600"><%= flash[:notice] %></p>
    </div>
  <% end %>

  <% if flash[:error].present? %>
    <div class="mb-4 p-4 rounded-md bg-red-50 border border-red-200">
      <p class="text-red-600"><%= flash[:error] %></p>
    </div>
  <% end %>

  <%= form_with(model: @user, local: true, class: "space-y-4") do |f| %>
    <div>
      <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :name, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent", placeholder: "John Doe" %>
    </div>

    <div>
      <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.email_field :email, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent", placeholder: "john@example.com" %>
    </div>

    <div>
      <%= f.label :referral_code, "Referral Code (optional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :referral_code, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent", placeholder: "Enter referral code" %>
    </div>

    <div class="mt-6">
      <%= f.submit "Create Account", class: "w-full bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-colors duration-200" %>
    </div>
  <% end %>
</div> 